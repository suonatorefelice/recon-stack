# Esempio di configurazione di Recon-Stack.
#
# In DevStack il plugin scrive il file vero in /etc/recon-stack/recon-stack.conf.
# Ogni opzione è spiegata in recon_stack/conf.py; qui ci sono i valori
# predefiniti, commentati: si toglie il # per cambiarne uno.

[DEFAULT]
# Scrive nei log anche i messaggi di dettaglio (livello DEBUG).
#debug = false

[database]
# Indirizzo del database nel formato di SQLAlchemy. In DevStack il plugin
# indica un file in $DATA_DIR/recon-stack/.
#connection = sqlite:///recon-stack.sqlite
# Solo SQLite: millisecondi di attesa se un altro processo sta scrivendo.
#busy_timeout = 5000

[api]
# Porta TCP su cui ascolta recon-api.
#port = 5238

[scanner]
# Ogni quanti secondi recon-scanner scrive nel log che è attivo.
#heartbeat_interval = 60
# Nome del cloud in /etc/openstack/clouds.yaml da cui leggere l'inventario
# (Nova e Neutron). In DevStack 'devstack-admin' ha il ruolo admin.
#cloud = devstack-admin
# Numero massimo di indirizzi interni che un perimetro può avere (ADR 0005):
# oltre la soglia la scansione non parte.
#max_perimeter_addresses = 65536
# Secondi minimi fra due scansioni avviate dello stesso progetto (0 disattiva).
#min_scan_interval = 60
# Driver di rete di Neutron (ADR 0006): 'ovn' usa le namespace ovnmeta-<rete>,
# 'ovs' usa qdhcp-<rete>. Si verifica con 'sudo ip netns list'.
#network_driver = ovn
# Quante porte esamina il service discovery (nmap -sV, Step 7): 'comuni' = ~100
# porte (nmap -F), 'top1000' = 1000 porte (default nmap), 'tutte' = 65535 (-p-).
#service_scan_scope = top1000
